# Copy to .env and edit. The real file is git-ignored: your subnet and tokens stay on your machine.

# Subnets to scan, comma separated (private ranges only)
NETINV_SUBNETS=192.168.1.0/24

# NETINV_DB=data/netinv.db
# NETINV_INTERVAL=300            # seconds between scans
# NETINV_OFFLINE_AFTER=3         # missed scans before "offline"
# NETINV_RETENTION_DAYS=90       # history kept (0 = forever)
# NETINV_BIND=127.0.0.1          # Docker: address of the dashboard
# NETINV_PORT=8090

# Protect the dashboard (optional on localhost, recommended otherwise)
# NETINV_READ_TOKEN=
# NETINV_ADMIN_TOKEN=

# Notifications (all optional). Offline/online messages only for devices you `watch`.
# NETINV_NOTIFY_MIN_SEVERITY=medium     # info | low | medium | high
# NETINV_TELEGRAM_TOKEN=
# NETINV_TELEGRAM_CHAT_ID=
# NETINV_WEBHOOK_URL=
# NETINV_WEBHOOK_FORMAT=json            # json | discord
# NETINV_SMTP_HOST=
# NETINV_SMTP_FROM=
# NETINV_SMTP_TO=

# Discovery (all optional)
# NETINV_DISCOVERY=true          # ask devices for their name: SSDP, mDNS, NetBIOS
# NETINV_TCP_PORTS=22,80,443     # try these ports on addresses that ignore ping (off by default)
# NETINV_SNMP_COMMUNITY=         # read-only SNMP v2c community, for switches and printers
# NETINV_SCANNER=ping            # or nmap
# NETINV_CA_BUNDLE=              # extra trusted CAs for `netinv oui-update`
